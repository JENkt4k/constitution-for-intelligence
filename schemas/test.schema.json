{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JENkt4k/constitution-for-intelligence/schemas/test.schema.json",
  "title": "Constitution for Intelligence Test",
  "type": "object",
  "required": ["id", "name", "scenario", "expected"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^T[0-9]{2,}$"},
    "name": {"type": "string", "minLength": 1},
    "scenario": {"type": "string", "minLength": 1},
    "expected": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "result": {"type": "string", "minLength": 1},
        "preferred": {"type": "string", "minLength": 1},
        "violations": {"$ref": "#/$defs/invariants"},
        "principles": {"$ref": "#/$defs/invariants"}
      },
      "additionalProperties": false,
      "anyOf": [
        {"required": ["result"]},
        {"required": ["preferred"]}
      ]
    }
  },
  "$defs": {
    "invariants": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^I[0-9]{2}_[a-z0-9_]+$"}
    }
  }
}
